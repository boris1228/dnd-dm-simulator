## 3. Cursor 代码调用示例 (Python API Payload)

```python
def build_sd_payload(scene_type: str, description: str, needs_grid: bool = False) -> dict:
    if scene_type == "character":
        return {
            "override_settings": {"sd_model_checkpoint": "DreamShaper_8_LCM.safetensors"},
            "sampler_name": "LCM",
            "steps": 8,
            "cfg_scale": 2.0,
            "width": 512,
            "height": 768,
            "prompt": f"(masterpiece, top quality:1.2), DD_Painterly, official D&D illustration style, painterly texture, {description}, <lora:DD_Painterly:1>",
            "negative_prompt": "(worst quality, low quality:1.4), 3d render, smooth skin, plastic, modern clothing, ugly, lowres"
        }
    elif scene_type == "battlemap":
        grid_keyword = "square grid, gridded battlemap," if needs_grid else "gridless,"
        negative_grid = "" if needs_grid else "grid, hex grid,"
        return {
            "override_settings": {"sd_model_checkpoint": "dndMapGenerator_v3.safetensors"},
            "sampler_name": "DPM++ 2M Karras",
            "steps": 20,
            "cfg_scale": 7.0,
            "width": 768,
            "height": 768,
            "prompt": f"2d dnd battlemap, top-down view, {grid_keyword} {description}",
            "negative_prompt": f"{negative_grid} 3d, perspective, isometric, characters, text, watermark, low quality, blurry"
        }
    elif scene_type in ["cover", "regional_map"]:
        return {
            "override_settings": {
                "sd_model_checkpoint": "dndCoverArt_v10_SD1.safetensors",
                "sd_vae": "vae-ft-mse-840000-ema-pruned.vae.pt"
            },
            "sampler_name": "DPM++ 2M Karras",
            "steps": 20,
            "cfg_scale": 7.0,
            "width": 512 if scene_type == "cover" else 768,
            "height": 768 if scene_type == "cover" else 512,
            "prompt": f"dnd cover art, book cover illustration, official D&D style, {description}",
            "negative_prompt": "text, title, logo, watermark, typography, signature, words, (worst quality, low quality:1.4), 3d render"
        }
